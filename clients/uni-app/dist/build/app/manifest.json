{
  "@platforms": [
    "android",
    "iPhone",
    "iPad"
  ],
  "id": "",
  "name": "鹏派优选",
  "version": {
    "name": "0.1.0",
    "code": "100"
  },
  "description": "多平台 CPS 返利",
  "developer": {
    "name": "",
    "email": "",
    "url": ""
  },
  "permissions": {
    "UniNView": {
      "description": "UniNView原生渲染"
    }
  },
  "plus": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "splashscreen": {
      "target": "id:1",
      "autoclose": true,
      "waiting": true,
      "delay": 0
    },
    "popGesture": "close",
    "launchwebview": {
      "id": "1",
      "kernel": "WKWebview"
    },
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "distribute": {
      "google": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "apple": {},
      "plugins": {
        "audio": {
          "mp3": {
            "description": "Android平台录音支持MP3格式文件"
          }
        }
      }
    },
    "statusbar": {
      "immersed": "supportedDevice",
      "style": "dark",
      "background": "#FFFFFF"
    },
    "allowsInlineMediaPlayback": true,
    "safearea": {
      "background": "#FFFFFF",
      "bottom": {
        "offset": "auto"
      }
    },
    "uni-app": {
      "control": "uni-v3",
      "vueVersion": "3",
      "compilerVersion": "4.65",
      "nvueCompiler": "uni-app",
      "renderer": "auto",
      "nvue": {
        "flex-direction": "column"
      },
      "nvueLaunchMode": "normal",
      "webView": {
        "minUserAgentVersion": "49.0"
      }
    },
    "tabBar": {
      "position": "bottom",
      "color": "#8E8E93",
      "selectedColor": "#007AFF",
      "borderStyle": "rgba(255,255,255,0.4)",
      "blurEffect": "none",
      "fontSize": "10px",
      "iconWidth": "24px",
      "spacing": "3px",
      "height": "50px",
      "list": [
        {
          "pagePath": "pages/index/index",
          "text": "首页",
          "iconPath": "/static/tabbar/home.png",
          "selectedIconPath": "/static/tabbar/home-active.png"
        },
        {
          "pagePath": "pages/life/life",
          "text": "吃喝玩乐",
          "iconPath": "/static/tabbar/life.png",
          "selectedIconPath": "/static/tabbar/life-active.png"
        },
        {
          "pagePath": "pages/orders/orders",
          "text": "我的订单",
          "iconPath": "/static/tabbar/order.png",
          "selectedIconPath": "/static/tabbar/order-active.png"
        }
      ],
      "backgroundColor": "#FFFFFF",
      "selectedIndex": 0,
      "shown": true,
      "child": [
        "lauchwebview"
      ],
      "selected": 0
    }
  },
  "app-harmony": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "safearea": {
      "background": "#FFFFFF",
      "bottom": {
        "offset": "auto"
      }
    }
  },
  "locale": "zh-Hans",
  "launch_path": "__uniappview.html"
}