/**
 * pages/logs/logs.wxss — 启动日志（iOS 风格）
 */

.scrollarea {
  height: 100vh;
  background: var(--ios-bg);
}

.log-item {
  margin: 16rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ios-label);
  box-shadow: var(--shadow-card);
}
