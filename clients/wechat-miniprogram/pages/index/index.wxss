/**
 * pages/index/index.wxss — 首页（iOS 风格）
 * 布局：iOS 分组列表形态 —— 灰底 + 白卡片，主色系统蓝，分段控件切换商品源
 * 弹窗/加载/空状态类复用 app.wxss 全局定义
 */

.page {
  padding-bottom: 40rpx;
}

/* ==================== 顶部搜索栏（自定义导航，让位胶囊） ==================== */

.search-bar {
  padding: 16rpx 32rpx 16rpx;
  background: var(--ios-bg);
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--ios-label2);
}

/* ==================== 粘贴链接转链卡片 ==================== */

.link-section {
  margin: 8rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.link-input-wrap {
  position: relative;
}

.link-textarea {
  width: 100%;
  height: 140rpx;
  background: var(--ios-fill);
  border-radius: var(--radius-control);
  padding: 20rpx 140rpx 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--ios-label);
  line-height: 1.5;
}

.link-placeholder {
  color: var(--ios-label3);
}

/* 粘贴按钮：iOS tinted 小按钮 */
.link-paste-btn {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  padding: 10rpx 28rpx;
  background: var(--ios-blue-tint);
  color: var(--ios-blue);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 26rpx;
}

.link-paste-btn-hover {
  background: rgba(0, 122, 255, 0.22);
}

/* 主按钮：iOS filled 蓝，胶囊 */
.link-find-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.link-find-btn:active {
  background: var(--ios-blue-press);
}

.btn-disabled {
  background: var(--ios-label3);
  color: #FFFFFF;
}

/* ==================== 转换结果卡片 ==================== */

.link-result-card {
  margin: 24rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-label-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.result-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ios-fill);
  border-radius: 24rpx;
  color: var(--ios-label2);
  font-size: 24rpx;
}

.result-body {
  margin-top: 20rpx;
}

.result-section {
  padding: 12rpx 0;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: var(--ios-label2);
  margin-bottom: 8rpx;
}

.result-url-text {
  display: block;
  font-size: 24rpx;
  color: var(--ios-label);
  word-break: break-all;
  line-height: 1.5;
}

.result-url-highlight {
  color: var(--ios-blue);
}

.result-divider {
  height: 1px;
  background: var(--ios-separator);
  margin: 8rpx 0;
}

/* 结果操作按钮：主蓝 + 次 tinted */
.result-copy-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  padding: 0;
}

.result-copy-btn::after {
  border: none;
}

.result-copy-btn:active {
  background: var(--ios-blue-press);
}

.result-jump-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--ios-blue-tint);
  color: var(--ios-blue);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 42rpx;
  padding: 0;
}

.result-jump-btn::after {
  border: none;
}

.result-jump-btn:active {
  background: rgba(0, 122, 255, 0.22);
}

/* ==================== 今日活动（分组卡片） ==================== */

.activity-section {
  margin: 32rpx 32rpx 0;
}

.activity-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  display: flex;
  align-items: center;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.activity-card-hover {
  background: rgba(255, 255, 255, 0.75);
  transform: scale(0.985);
}

.activity-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--ios-fill);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-image-img {
  width: 100%;
  height: 100%;
}

.activity-image-placeholder {
  font-size: 22rpx;
  color: var(--ios-label3);
}

.activity-head-text {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.activity-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.activity-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ios-label2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 精选商品（iOS 分段控件 + 瀑布流） ==================== */

.goods-section {
  margin: 32rpx 32rpx 0;
}

/* iOS Segmented Control */
.goods-tabs {
  display: flex;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 4rpx;
}

.goods-tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--ios-label);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.goods-tab-active {
  background: var(--ios-card);
  color: var(--ios-label);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 瀑布流 */
.waterfall-grid {
  margin-top: 24rpx;
  column-count: 2;
  column-gap: 20rpx;
}

.goods-card {
  break-inside: avoid;
  margin-bottom: 20rpx;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}

.goods-card-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.goods-image {
  width: 100%;
  display: block;
  background: var(--ios-fill);
}

.goods-info {
  padding: 16rpx 20rpx 20rpx;
}

.goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  color: var(--ios-label);
  line-height: 1.45;
}

.goods-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ios-label2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
}

.goods-price-flag {
  font-size: 20rpx;
  color: var(--ios-red);
  background: rgba(255, 59, 48, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.goods-original-price {
  font-size: 22rpx;
  color: var(--ios-label3);
  text-decoration: line-through;
}

.goods-loading {
  padding: 32rpx 0;
  text-align: center;
  color: var(--ios-label2);
  font-size: 26rpx;
}

.goods-end {
  padding: 32rpx 0 16rpx;
  text-align: center;
  color: var(--ios-label3);
  font-size: 24rpx;
}
