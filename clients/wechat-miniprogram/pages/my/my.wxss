/* pages/my/my.wxss 个人中心（iOS 设计令牌见 app.wxss） */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 未登录引导 ===== */
.login-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 80rpx 40rpx;
  box-shadow: var(--shadow-card);
}

.login-guide__avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--ios-fill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ios-label3);
  font-size: 56rpx;
  font-weight: 600;
}

.login-guide__title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.login-guide__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ios-label3);
}

.login-guide__btn {
  margin-top: 48rpx;
  padding: 0 80rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

/* ===== 用户信息卡 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-card__avatar--placeholder {
  background: var(--ios-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
}

.user-card__info {
  margin-left: 24rpx;
  overflow: hidden;
}

.user-card__name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.user-card__phone {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ios-label2);
}

/* ===== 账号信息卡 ===== */
.info-card {
  margin-top: 20rpx;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 8rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.info-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 0.5px solid var(--ios-separator);
}

.info-card__row:last-child {
  border-bottom: none;
}

.info-card__label {
  font-size: 26rpx;
  color: var(--ios-label2);
}

.info-card__value {
  font-size: 26rpx;
  color: var(--ios-label);
}

/* ===== 菜单卡 ===== */
.menu-card {
  margin-top: 20rpx;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 8rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 0.5px solid var(--ios-separator);
}

.menu-card__item:last-child {
  border-bottom: none;
}

.menu-card__label {
  font-size: 28rpx;
  color: var(--ios-label);
}

.menu-card__value {
  font-size: 24rpx;
  color: var(--ios-label3);
}

.menu-card__arrow {
  font-size: 34rpx;
  color: var(--ios-label3);
}

/* ===== 退出登录 ===== */
.logout-btn {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: var(--ios-card);
  color: var(--ios-red);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 交互反馈 */
.btn-hover {
  opacity: 0.85;
}

.item-hover {
  background: var(--ios-fill);
}
