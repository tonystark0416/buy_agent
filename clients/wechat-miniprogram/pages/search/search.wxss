/**
 * pages/search/search.wxss — 商品搜索（iOS 风格）
 * 布局：iOS 搜索场 —— 灰底输入场、胶囊历史标签、分段控件筛平台、双列卡片流
 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ==================== 搜索栏 ==================== */

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: var(--ios-bg);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 0 24rpx;
  transition: box-shadow 0.2s ease, background 0.2s ease;
}

/* 聚焦态：iOS 蓝描边光晕 */
.search-input-focus {
  background: var(--ios-card);
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.35);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ios-label);
}

.search-placeholder {
  color: var(--ios-label2);
}

/* 清除按钮：iOS 圆形灰底 ✕ */
.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ios-fill-strong);
  border-radius: 20rpx;
}

.clear-icon {
  color: var(--ios-card);
  font-size: 20rpx;
  font-weight: 700;
}

.search-btn {
  color: var(--ios-blue);
  font-size: 30rpx;
  font-weight: 500;
  padding: 12rpx 8rpx;
}

.search-btn:active {
  opacity: 0.55;
}

/* ==================== 搜索历史（分组卡片） ==================== */

.history-panel {
  margin: 8rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-label2);
}

.history-clear {
  font-size: 26rpx;
  color: var(--ios-blue);
}

.history-clear:active {
  opacity: 0.55;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.history-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--ios-fill);
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}

.history-tag:active {
  background: var(--ios-fill-strong);
}

.history-tag-text {
  font-size: 26rpx;
  color: var(--ios-label);
}

.history-tag-del {
  font-size: 20rpx;
  color: var(--ios-label3);
}

/* ==================== 平台 Tab（iOS 分段控件） ==================== */

.platform-tabs {
  margin: 24rpx 32rpx 0;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 4rpx;
}

.tabs-scroll {
  display: flex;
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 72rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-active {
  background: var(--ios-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.tab-text {
  font-size: 27rpx;
  color: var(--ios-label);
}

/* 分段控件形态下隐藏下划线 */
.tab-line {
  display: none;
}

/* ==================== 商品列表（双列卡片） ==================== */

.product-scroll {
  flex: 1;
  min-height: 0;
}

.state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.state-icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ios-fill);
  border-radius: 64rpx;
}

.state-emoji {
  font-size: 56rpx;
  opacity: 0.7;
}

.state-text {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ios-label);
}

.state-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ios-label2);
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.product-card {
  width: calc((100% - 20rpx) / 2);
  background: var(--ios-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
  position: relative;
}

.product-card-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.product-img {
  width: 100%;
  height: 340rpx;
  background: var(--ios-fill);
}

/* 平台角标（颜色由 wxml 内联下发，这里只管形态） */
.platform-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
}

.platform-tag text {
  display: inline-block;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  color: var(--ios-label);
  line-height: 1.45;
  min-height: 76rpx;
}

.product-price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-left {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ios-red);
}

.price-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-red);
}

/* 券标签：iOS red tinted */
.coupon-tag {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--ios-red);
  background: rgba(255, 59, 48, 0.1);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.original-price {
  font-size: 22rpx;
  color: var(--ios-label3);
  text-decoration: line-through;
}

/* ==================== 加载态（iOS spinner 灰圈） ==================== */

.loading-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0 48rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--ios-separator);
  border-top-color: var(--ios-label2);
  border-radius: 50%;
  animation: ios-spin 0.8s linear infinite;
}

@keyframes ios-spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--ios-label2);
}

.no-more {
  color: var(--ios-label3);
}
