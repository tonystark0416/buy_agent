/**
 * pages/goods/goods.wxss — 商品详情（iOS 风格）
 * 布局：iOS 分组形态 —— 大图置顶、信息白卡片分组、底部毛玻璃操作栏 + 胶囊主按钮
 * 弹窗/返回按钮/加载类复用 app.wxss 全局定义
 */

.page {
  background: var(--ios-bg);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
}

/* ==================== 主图 ==================== */

.goods-image,
.goods-swiper {
  width: 100%;
  height: 750rpx;
  background: var(--ios-fill);
}

/* ==================== 价格区（白卡片） ==================== */

.price-section {
  margin: 24rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-symbol {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.price-value {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--ios-red);
  letter-spacing: -1rpx;
}

.original-price {
  font-size: 26rpx;
  color: var(--ios-label3);
  text-decoration: line-through;
}

/* 价格构成行（如 券后价-补贴） */
.price-desc-row {
  margin-top: 16rpx;
}

.price-desc-inner {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.price-desc-part {
  font-size: 22rpx;
  color: var(--ios-red);
}

.price-desc-part-hl {
  font-weight: 700;
}

.price-desc-minus {
  font-size: 22rpx;
  color: var(--ios-red);
  opacity: 0.7;
}

/* 返力行 */
.rebate-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 0.5px solid var(--ios-separator);
}

.rebate-label {
  font-size: 24rpx;
  color: var(--ios-label2);
}

.rebate-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-green);
}

.rebate-rate {
  font-size: 22rpx;
  color: var(--ios-green);
}

/* ==================== 标题区（白卡片） ==================== */

.info-section {
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.goods-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-label);
  line-height: 1.5;
}

.goods-sales {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ios-label2);
}

/* ==================== 标签行 ==================== */

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 32rpx 0;
}

.tag-item {
  font-size: 22rpx;
  color: var(--ios-blue);
  background: var(--ios-blue-tint);
  border-radius: 10rpx;
  padding: 6rpx 18rpx;
}

/* ==================== 品牌/店铺/分类（iOS inset grouped list） ==================== */

.meta-section {
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 8rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.meta-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-label);
  padding: 24rpx 0 8rpx;
}

.meta-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 0.5px solid var(--ios-separator);
}

.meta-item:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 26rpx;
  color: var(--ios-label2);
  flex-shrink: 0;
}

.meta-value {
  font-size: 26rpx;
  color: var(--ios-label);
  text-align: right;
  line-height: 1.5;
}

/* ==================== 详情图集 ==================== */

.detail-images {
  margin: 20rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

/* ==================== 门店卡片（meituan-goods 复用此类名结构） ==================== */

.store-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.store-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--ios-fill);
}

.store-text {
  flex: 1;
  min-width: 0;
}

.store-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-label);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.store-meta-item {
  font-size: 22rpx;
  color: var(--ios-label2);
}

/* ==================== 底部操作栏（iOS 毛玻璃 + 胶囊主按钮） ==================== */

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 0.5px solid var(--ios-separator);
}

.bottom-rebate {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
}

.bottom-rebate-label {
  font-size: 20rpx;
  color: var(--ios-label2);
}

.bottom-rebate-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-green);
}

.buy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.buy-btn::after {
  border: none;
}

.buy-btn:active {
  background: var(--ios-blue-press);
}
