/**
 * pages/orders/orders.wxss — 我的订单（iOS 风格）
 * 布局：iOS 分组列表 —— 白卡片订单、hairline 内部分隔、平台 tab 分段控件
 * 注：tab 文字/下划线颜色由 JS 内联下发（平台品牌色），此处只做容器与卡片
 */

.orders-page {
  padding-bottom: 60rpx;
}

/* ==================== 平台 Tab（iOS 分段控件） ==================== */

.platform-tabs {
  display: flex;
  margin: 20rpx 32rpx 0;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 4rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-active {
  background: var(--ios-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.tab-text {
  font-size: 27rpx;
  color: var(--ios-label);
}

/* 下划线在分段控件形态下隐藏（选中态由白底浮起表达） */
.tab-line {
  display: none;
}

/* ==================== 列表区 ==================== */

.order-list {
  padding: 0 32rpx;
}

/* ==================== 订单卡片（iOS inset grouped） ==================== */

.order-card {
  margin-top: 24rpx;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 0 28rpx;
  box-shadow: var(--shadow-card);
}

.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
  border-bottom: 0.5px solid var(--ios-separator);
}

.order-sn {
  font-size: 24rpx;
  color: var(--ios-label2);
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-blue);
}

.order-card-body {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}

.order-goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--ios-fill);
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-goods-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  color: var(--ios-label);
  line-height: 1.4;
}

.order-platform {
  font-size: 22rpx;
  color: var(--ios-blue);
  background: var(--ios-blue-tint);
  align-self: flex-start;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--ios-label2);
}

.order-card-footer {
  border-top: 0.5px solid var(--ios-separator);
  padding: 20rpx 0 24rpx;
  display: flex;
  justify-content: flex-end;
}

.order-amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.order-amount-label {
  font-size: 24rpx;
  color: var(--ios-label2);
}

.order-amount-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-label);
}

/* ==================== 加载 / 空状态 ==================== */

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 88rpx;
  opacity: 0.6;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--ios-label2);
}

/* 刷新按钮：iOS tinted 胶囊 */
.retry-btn {
  margin-top: 32rpx;
  padding: 14rpx 56rpx;
  background: var(--ios-blue-tint);
  color: var(--ios-blue);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
}

.retry-btn:active {
  background: rgba(0, 122, 255, 0.22);
}

.load-more {
  padding: 32rpx 0 0;
  text-align: center;
  color: var(--ios-label3);
  font-size: 24rpx;
}
