/**
 * pages/life/life.wxss — 吃喝玩乐（iOS 风格）
 * 布局：iOS 分组列表 —— 灰底白卡片、hairline 分隔、胶囊搜索、系统蓝交互
 */

.page {
  padding: 0 0 60rpx;
}

/* ==================== 搜索栏 ==================== */

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: var(--ios-bg);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 0 24rpx;
  transition: box-shadow 0.2s ease;
}

/* CSS 绘制搜索放大镜 */
.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--ios-label2);
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 14rpx;
  background: var(--ios-label2);
  transform: rotate(-45deg);
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ios-label);
}

.search-placeholder {
  color: var(--ios-label2);
}

.search-clear {
  color: var(--ios-label2);
  font-size: 26rpx;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

/* 搜索按钮：iOS tinted 文字按钮 */
.search-btn {
  color: var(--ios-blue);
  font-size: 30rpx;
  font-weight: 500;
  padding: 12rpx 8rpx;
}

.search-btn:active {
  opacity: 0.55;
}

/* ==================== 活动卡片（分组列表形态） ==================== */

.banner-card {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.banner-card-hover {
  background: rgba(255, 255, 255, 0.75);
}

.banner-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: var(--ios-fill);
}

.banner-info {
  flex: 1;
  padding: 24rpx 28rpx;
  position: relative;
}

.banner-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
  padding-right: 48rpx;
}

.banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ios-label2);
  line-height: 1.5;
  padding-right: 48rpx;
}

/* iOS chevron */
.banner-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--ios-label3);
  font-size: 40rpx;
  font-weight: 300;
}

/* ==================== 排序栏（iOS 分段控件） ==================== */

.sort-bar {
  display: flex;
  margin: 32rpx 32rpx 0;
  background: var(--ios-fill);
  border-radius: 20rpx;
  padding: 4rpx;
}

.sort-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ios-label);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.sort-item-active {
  background: var(--ios-card);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* ==================== 搜索结果商品卡片 ==================== */

.goods-card {
  display: flex;
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 20rpx;
  box-shadow: var(--shadow-card);
  gap: 20rpx;
}

.goods-card-hover {
  background: rgba(255, 255, 255, 0.75);
}

.goods-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--ios-fill);
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title-wrap {
  overflow: hidden;
}

.goods-brand {
  display: inline-block;
  font-size: 20rpx;
  color: var(--ios-blue);
  background: var(--ios-blue-tint);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-bottom: 6rpx;
  margin-right: 8rpx;
}

.goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  color: var(--ios-label);
  line-height: 1.4;
}

.goods-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ios-label2);
}

.goods-poi,
.goods-sales {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 10rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.goods-original {
  font-size: 22rpx;
  color: var(--ios-label3);
  text-decoration: line-through;
}

/* 返利标签：iOS 绿 tinted */
.goods-rebate {
  font-size: 20rpx;
  color: var(--ios-green);
  background: rgba(52, 199, 89, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.goods-footer {
  padding: 32rpx 0 0;
  text-align: center;
  color: var(--ios-label3);
  font-size: 24rpx;
}
