/**
 * pages/meituan-goods/meituan-goods.wxss — 美团套餐详情（iOS 风格）
 * 与 goods.wxss 同构：分组卡片 + 毛玻璃底栏；门店卡片独立分区
 * 注意：本页未复用 goods.wxss（独立页面文件），样式保持同风格实现
 */

.page {
  background: var(--ios-bg);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
}

/* ==================== 主图 ==================== */

.goods-image {
  width: 100%;
  height: 750rpx;
  background: var(--ios-fill);
}

/* ==================== 价格区 ==================== */

.price-section {
  margin: 24rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.price-symbol {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.price-value {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--ios-red);
  letter-spacing: -1rpx;
}

.original-price {
  font-size: 26rpx;
  color: var(--ios-label3);
  text-decoration: line-through;
}

.price-label {
  font-size: 22rpx;
  color: var(--ios-orange);
  background: rgba(255, 149, 0, 0.12);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.rebate-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 0.5px solid var(--ios-separator);
}

.rebate-label {
  font-size: 24rpx;
  color: var(--ios-label2);
}

.rebate-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-green);
}

/* ==================== 标题区 ==================== */

.info-section {
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.goods-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-label);
  line-height: 1.5;
}

.goods-sales {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ios-label2);
}

/* ==================== 门店卡片 ==================== */

.store-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 32rpx 0;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.store-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--ios-fill);
}

.store-text {
  flex: 1;
  min-width: 0;
}

.store-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-label);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.store-meta-item {
  font-size: 22rpx;
  color: var(--ios-label2);
}

/* ==================== 购买须知（inset grouped list） ==================== */

.meta-section {
  margin: 20rpx 32rpx 40rpx;
  background: var(--ios-card);
  border-radius: var(--radius-card);
  padding: 8rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.meta-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-label);
  padding: 24rpx 0 8rpx;
}

.meta-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 0.5px solid var(--ios-separator);
}

.meta-item:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 26rpx;
  color: var(--ios-label2);
  flex-shrink: 0;
}

.meta-value {
  font-size: 26rpx;
  color: var(--ios-label);
  text-align: right;
  line-height: 1.5;
}

/* ==================== 底部操作栏 ==================== */

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 0.5px solid var(--ios-separator);
}

.buy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.buy-btn::after {
  border: none;
}

.buy-btn:active {
  background: var(--ios-blue-press);
}
