/**
 * app.wxss — 全局设计系统（iOS / Apple HIG 风格）
 * 设计令牌：颜色、圆角、阴影、字体统一在此定义，页面样式引用这些变量
 * 共享组件类：iOS 风格弹窗、加载态、返回按钮（多页面复用，页面 wxss 不再重复定义）
 */

page {
  /* ---- 颜色令牌 ---- */
  --ios-blue: #007AFF;            /* 系统主色 */
  --ios-blue-press: #0062CC;      /* 主色按压态 */
  --ios-blue-tint: rgba(0, 122, 255, 0.12);   /* 主色浅底（次级按钮/选中态） */
  --ios-red: #FF3B30;             /* 价格/警示 */
  --ios-green: #34C759;
  --ios-orange: #FF9500;

  --ios-bg: #F2F2F7;              /* 分组背景（页面底色） */
  --ios-card: #FFFFFF;            /* 卡片 */
  --ios-fill: rgba(118, 118, 128, 0.12);      /* 输入框/分段控件轨道 */
  --ios-fill-strong: rgba(118, 118, 128, 0.2);

  --ios-label: #1C1C1E;           /* 主文字 */
  --ios-label2: #8E8E93;          /* 次要文字 */
  --ios-label3: #C7C7CC;          /* 占位/禁用 */
  --ios-separator: rgba(60, 60, 67, 0.12);    /* 分隔线 */

  /* ---- 圆角/阴影 ---- */
  --radius-card: 24rpx;           /* 卡片 12pt */
  --radius-control: 20rpx;        /* 输入框/小控件 */
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);

  background-color: var(--ios-bg);
  color: var(--ios-label);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 30rpx;               /* body */
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ==================== 页面容器 ==================== */

.page,
.orders-page {
  min-height: 100vh;
  background-color: var(--ios-bg);
  box-sizing: border-box;
}

/* ==================== iOS 弹窗（Alert 风格，4 个页面复用） ==================== */

.login-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  animation: ios-fade-in 0.2s ease-out;
}

.login-dialog {
  position: relative;
  width: 620rpx;
  background: rgba(249, 249, 249, 0.97);
  border-radius: 28rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  animation: ios-pop-in 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-label);
  letter-spacing: 0.5rpx;
}

.login-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ios-label2);
  line-height: 1.6;
}

/* iOS 主操作按钮：filled 蓝，胶囊形 */
.login-phone-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--ios-blue);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  padding: 0;
}

.login-phone-btn::after {
  border: none;
}

.login-phone-btn:active {
  background: var(--ios-blue-press);
}

/* iOS 次要动作：纯文字按钮 */
.login-skip {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--ios-label2);
  padding: 12rpx 0;
}

/* ==================== 加载 / 空状态 ==================== */

.loading-container,
.goods-status,
.loading,
.search-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--ios-label2);
  font-size: 28rpx;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--ios-label2);
  font-size: 28rpx;
}

/* ==================== 详情页返回按钮（goods / meituan-goods 复用） ==================== */

.nav-back-btn {
  position: fixed;
  z-index: 100;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.nav-back-btn-hover {
  background: rgba(255, 255, 255, 0.7);
}

/* iOS 返回箭头（CSS 绘制） */
.nav-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ios-label);
  border-bottom: 4rpx solid var(--ios-label);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* ==================== 动画 ==================== */

@keyframes ios-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ios-pop-in {
  from { opacity: 0; transform: scale(1.12); }
  to { opacity: 1; transform: scale(1); }
}
